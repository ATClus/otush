[Desktop Entry]
Type=Application
Name=Otush
GenericName=AI Voice & Productivity Suite
Comment=Native speech-to-text, meeting intelligence, notes, tasks, OCR, and AI research for GNOME
Exec=/usr/bin/otush
Path=/usr/bin
Icon=com.clusterat.otush
Terminal=false
Categories=Utility;AudioVideo;Accessibility;Office;
Keywords=speech;text;transcription;dictation;whisper;voice;ai;llm;notes;todos;ocr;research;gnome;wayland;productivity;
StartupNotify=true
StartupWMClass=com.clusterat.otush
X-GNOME-UsesNotifications=true

